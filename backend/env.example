# Copy to backend/.env and fill in what you use. Everything is optional except
# ADMIN_PASSWORD and at least one cloud key (or a local Ollama).

# ── Auth ─────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=

# ── LLM providers (tier 3) ───────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Setting this also enables the Claude tool-use loop for every chat turn.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Local models (tiers 1-2) ─────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
ZEPHYRO_MODEL_FAST=llama3.2:1b
ZEPHYRO_MODEL_BALANCED=llama3.2:3b

# ── Behaviour flags ──────────────────────────────────────────────────────────
# off | shadow | on (see docs/adr/0006-per-turn-reasoning-policy.md)
ZEPHYRO_REASONING_POLICY=shadow
ZEPHYRO_CI_WATCH=0
LOG_LEVEL=INFO

# ── Web search ───────────────────────────────────────────────────────────────
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Channels ─────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_IDS=
WHATSAPP_ENABLED=false
WHATSAPP_AUTHORIZED_IDS=

# ── Memory (optional; falls back to a local JSON store) ──────────────────────
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# ── Integrations (optional) ──────────────────────────────────────────────────
CANVAS_BASE_URL=
CANVAS_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
SCHEDULER_TIMEZONE=America/Argentina/Buenos_Aires
